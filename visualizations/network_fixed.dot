digraph NetworkFlow {
    // Graph settings
    rankdir=TB;
    node [shape=none, fontname="Arial"];
    edge [fontname="Arial", fontsize=12];
    bgcolor="white";
    pad=0.5;

    // Title
    labelloc="t";
    label="Network Flow Diagram";
    fontsize=24;
    fontname="Arial";

    // Nodes
    "AdvanceSimulationTime" [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f5f5f5" COLOR="#666666"><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="16" COLOR="#666666"><B>AdvanceSimulationTime</B></FONT></TD></TR><TR><TD COLSPAN="2" HEIGHT="2" BGCOLOR="#cccccc"></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">payload_key:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">unwrapped_payload</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">type:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">ProcessSimTimeAdvanceCommandPayload</FONT></TD></TR></TABLE>>];
    "CalculateGSD" [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff8e1" COLOR="#ffa000"><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="16" COLOR="#ffa000"><B>CalculateGSD</B></FONT></TD></TR><TR><TD COLSPAN="2" HEIGHT="2" BGCOLOR="#cccccc"></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">distance_key:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">distance_km</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">distance_km:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">400.0</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">focal_length_mm:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">500.0</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">geometry_results_key:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">geometry_results</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">gsd_storage_key:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">gsd_m_per_px</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">image_height_px:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">6000.0</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">image_width_px:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">4000.0</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">sensor_height_mm:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">36.0</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">sensor_width_mm:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">24.0</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">source_pos_key:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">observer_position_ecef_km</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">target_pos_key:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">target_position_ecef_km</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">time_delay:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">1.0</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">time_processing:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">0.0</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">type:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">CalculateGSD</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">use_ecef_positions:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">true</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">use_sensor_height:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">true</FONT></TD></TR></TABLE>>];
    "CalculatePosition" [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f1f8e9" COLOR="#689f38"><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="16" COLOR="#689f38"><B>CalculatePosition</B></FONT></TD></TR><TR><TD COLSPAN="2" HEIGHT="2" BGCOLOR="#cccccc"></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">duration_seconds:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">1.0</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">satellite_name_key:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">satellite_name</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">single_time_point:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">true</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">start_time_key:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">access_start_time_iso</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">step_seconds:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">1.0</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">storage_key:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">geometry_results</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">target_alt:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">0.0</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">target_alt_key:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">target_alt</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">target_lat:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">0.0</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">target_lat_key:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">aimpoint_latitude</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">target_lon:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">0.0</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">target_lon_key:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">aimpoint_longitude</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">time_delay:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">1.0</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">time_processing:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">0.0</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">tle_file_path:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">./data/satellites.json</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">type:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">CalculateGeometry</FONT></TD></TR></TABLE>>];
    "ConvertAccessTimeToISO" [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fce4ec" COLOR="#c2185b"><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="16" COLOR="#c2185b"><B>ConvertAccessTimeToISO</B></FONT></TD></TR><TR><TD COLSPAN="2" HEIGHT="2" BGCOLOR="#cccccc"></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">def value_fn(sim_time,msg):</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">import datetime; return datetime.datetime.fromt...</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">result_key:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">access_start_time_iso</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">time_delay:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">0.1</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">type:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">AddKeyValue</FONT></TD></TR></TABLE>>];
    "ConvertDownlinkTimeToDateTime" [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fce4ec" COLOR="#c2185b"><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="16" COLOR="#c2185b"><B>ConvertDownlinkTimeToDateTime</B></FONT></TD></TR><TR><TD COLSPAN="2" HEIGHT="2" BGCOLOR="#cccccc"></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">def value_fn(sim_time,msg):</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">return msg['UplinkTime'] + msg['downlinkTimeSec...</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">result_key:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">DownlinkTime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">time_delay:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">1</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">type:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">AddKeyValue</FONT></TD></TR></TABLE>>];
    "ConvertProcessingTimeToDateTime" [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fce4ec" COLOR="#c2185b"><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="16" COLOR="#c2185b"><B>ConvertProcessingTimeToDateTime</B></FONT></TD></TR><TR><TD COLSPAN="2" HEIGHT="2" BGCOLOR="#cccccc"></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">def value_fn(sim_time,msg):</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">return msg['DownlinkTime'] + msg['processingTim...</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">result_key:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">ProcessingTime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">time_delay:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">1</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">type:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">AddKeyValue</FONT></TD></TR></TABLE>>];
    "ConvertUplinkTimeToDateTime" [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fce4ec" COLOR="#c2185b"><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="16" COLOR="#c2185b"><B>ConvertUplinkTimeToDateTime</B></FONT></TD></TR><TR><TD COLSPAN="2" HEIGHT="2" BGCOLOR="#cccccc"></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">def value_fn(sim_time,msg):</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">return sim_time  + msg['uplinkTimeSecs']</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">result_key:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">UplinkTime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">time_delay:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">1</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">type:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">AddKeyValue</FONT></TD></TR></TABLE>>];
    "DownlinkTime" [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e8f5e9" COLOR="#388e3c"><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="16" COLOR="#388e3c"><B>DownlinkTime</B></FONT></TD></TR><TR><TD COLSPAN="2" HEIGHT="2" BGCOLOR="#cccccc"></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">population:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">[8 items]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">result_key:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">downlinkTimeSecs</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">time_delay:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">1</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">type:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">RandomDistrib</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">weights:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">[9 items]</FONT></TD></TR></TABLE>>];
    "FromQueue" [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e3f2fd" COLOR="#1976d2"><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="16" COLOR="#1976d2"><B>FromQueue</B></FONT></TD></TR><TR><TD COLSPAN="2" HEIGHT="2" BGCOLOR="#cccccc"></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">max_retry_attempts:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">3</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">poll_frequency_secs:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">11.0</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">pulsar_server:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">pulsar://localhost:30000</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">retry_delay_secs:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">10.0</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">retry_on_connection_error:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">true</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">simtime_field_name:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">simtime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">sub_name:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">my-sub</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">timeout_secs:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">50.0</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">topic_name:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">my-topic</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">type:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">PulsarTopicSource</FONT></TD></TR></TABLE>>];
    "ParseTaskingMessage" [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f3e5f5" COLOR="#7b1fa2"><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="16" COLOR="#7b1fa2"><B>ParseTaskingMessage</B></FONT></TD></TR><TR><TD COLSPAN="2" HEIGHT="2" BGCOLOR="#cccccc"></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">error_key:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">parse_error</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">json_key:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">json_data</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">object_result_field:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">payload</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">parsed_object_key:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">parsed_object</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">preserve_json:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">false</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">pydantic_types:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">['WrappedInputMessage']</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">result_key:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">parsed_message</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">successful_type_key:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">successful_type</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">time_delay:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">0.1</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">time_processing:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">0.0</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">type:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">ParseJsonMessage</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">write_out_field_list:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">All</FONT></TD></TR></TABLE>>];
    "ProcessBatchPayload" [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f5f5f5" COLOR="#666666"><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="16" COLOR="#666666"><B>ProcessBatchPayload</B></FONT></TD></TR><TR><TD COLSPAN="2" HEIGHT="2" BGCOLOR="#cccccc"></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">payload_key:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">unwrapped_payload</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">type:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">ProcessBatchPayload</FONT></TD></TR></TABLE>>];
    "ProcessingTime" [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e8f5e9" COLOR="#388e3c"><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="16" COLOR="#388e3c"><B>ProcessingTime</B></FONT></TD></TR><TR><TD COLSPAN="2" HEIGHT="2" BGCOLOR="#cccccc"></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">population:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">[8 items]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">result_key:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">processingTimeSecs</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">time_delay:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">1</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">type:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">RandomDistrib</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">weights:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">[9 items]</FONT></TD></TR></TABLE>>];
    "ProductDelivery" [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ffebee" COLOR="#c62828"><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="16" COLOR="#c62828"><B>ProductDelivery</B></FONT></TD></TR><TR><TD COLSPAN="2" HEIGHT="2" BGCOLOR="#cccccc"></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">pulsar_server:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">pulsar://localhost:30000</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">pydantic_class:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">CollectedTargetDataPayload</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">time_delay:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">0.1</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">topic_name:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">simulator_output_topic</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">type:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">PulsarTopicSink</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">use_pydantic_validation:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">true</FONT></TD></TR></TABLE>>];
    "SendSimulationStepCompletePayload" [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ffebee" COLOR="#c62828"><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="16" COLOR="#c62828"><B>SendSimulationStepCompletePayload</B></FONT></TD></TR><TR><TD COLSPAN="2" HEIGHT="2" BGCOLOR="#cccccc"></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">pulsar_server:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">pulsar://localhost:30000</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">pydantic_class:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">SimulationStepCompletePayload</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">time_delay:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">0.1</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">topic_name:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">simulator_output_topic</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">type:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">PulsarTopicSink</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">use_pydantic_validation:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">true</FONT></TD></TR></TABLE>>];
    "UnwrapPayload" [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f5f5f5" COLOR="#666666"><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="16" COLOR="#666666"><B>UnwrapPayload</B></FONT></TD></TR><TR><TD COLSPAN="2" HEIGHT="2" BGCOLOR="#cccccc"></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">store_unwrapped_payload_key:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">unwrapped_payload</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">type:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">UnwrapPayload</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">wrapped_message_key:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">successful_type</FONT></TD></TR></TABLE>>];
    "UplinkTime" [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e8f5e9" COLOR="#388e3c"><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="16" COLOR="#388e3c"><B>UplinkTime</B></FONT></TD></TR><TR><TD COLSPAN="2" HEIGHT="2" BGCOLOR="#cccccc"></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">population:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">[8 items]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">result_key:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">uplinkTimeSecs</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">time_delay:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">1</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">type:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">RandomDistrib</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">weights:</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#555555">[9 items]</FONT></TD></TR></TABLE>>];

    // Connections
    "FromQueue" -> "ParseTaskingMessage";
    "ParseTaskingMessage" -> "UnwrapPayload";
    "UnwrapPayload" -> "AdvanceSimulationTime" [label="AdvanceSimulationTime: unwrapped_payload == SimTimeAdvanceCommandPayload"];
    "UnwrapPayload" -> "ProcessBatchPayload" [label="ProcessBatchPayload: unwrapped_payload == SimTaskBatchPayload"];
    "ProcessBatchPayload" -> "UplinkTime";
    "AdvanceSimulationTime" -> "SendSimulationStepCompletePayload";
    "UplinkTime" -> "ConvertUplinkTimeToDateTime";
    "ConvertUplinkTimeToDateTime" -> "ConvertAccessTimeToISO";
    "ConvertAccessTimeToISO" -> "CalculatePosition";
    "CalculatePosition" -> "CalculateGSD";
    "CalculateGSD" -> "DownlinkTime";
    "DownlinkTime" -> "ConvertDownlinkTimeToDateTime";
    "ConvertDownlinkTimeToDateTime" -> "ProcessingTime";
    "ProcessingTime" -> "ConvertProcessingTimeToDateTime";
    "ConvertProcessingTimeToDateTime" -> "ProductDelivery";
    "ProductDelivery" -> "FromQueue";
    "SendSimulationStepCompletePayload" -> "FromQueue";
}